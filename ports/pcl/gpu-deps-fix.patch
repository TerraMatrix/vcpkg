--- a/gpu/CMakeLists.txt
+++ b/gpu/CMakeLists.txt
@@ -18,8 +18,22 @@ endif()

 collect_subproject_directory_names("${CMAKE_CURRENT_SOURCE_DIR}" "CMakeLists.txt" PCL_GPU_MODULES_NAMES PCL_GPU_MODULES_DIRS)
 set(PCL_GPU_MODULES_NAMES_UNSORTED ${PCL_GPU_MODULES_NAMES})
-topological_sort(PCL_GPU_MODULES_NAMES PCL_ _DEPENDS)
-sort_relative(PCL_GPU_MODULES_NAMES_UNSORTED PCL_GPU_MODULES_NAMES PCL_GPU_MODULES_DIRS)
+
+# Manually ensure gpu_utils is built first before other modules that depend on it
+set(PCL_GPU_MODULES_SORTED ${PCL_GPU_MODULES_NAMES})
+list(REMOVE_ITEM PCL_GPU_MODULES_SORTED utils)
+list(PREPEND PCL_GPU_MODULES_SORTED utils)
+
+# Re-order the directories accordingly
+set(PCL_GPU_MODULES_DIRS_SORTED)
+foreach(module_name ${PCL_GPU_MODULES_SORTED})
+  foreach(dir ${PCL_GPU_MODULES_DIRS})
+    if(dir MATCHES "^${module_name}/$")
+      list(APPEND PCL_GPU_MODULES_DIRS_SORTED ${dir})
+      break()
+    endif()
+  endforeach()
+endforeach()
+
 foreach(subdir ${PCL_GPU_MODULES_DIRS_SORTED})
   add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/${subdir}")
 endforeach()