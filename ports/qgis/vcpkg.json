{
  "name": "qgis",
  "version-string": "3.44.5",
  "description": "QGIS is a free, open source, cross platform (lin/win/mac) geographical information system (GIS)",
  "homepage": "https://qgis.org",
  "license": "GPL-2.0-or-later",
  "supports": "(windows & (x64 | arm64)) | (linux & arm64)",
  "dependencies": [
    {
      "name": "exiv2",
      "features": [
        "xmp"
      ]
    },
    "hdf5",
    "glib",
    "opencl",
    "expat",
    "gdal",
    "geos",
    "gsl",
    "jhasse-poly2tri",
    "libpq",
    "libspatialindex",
    "libspatialite",
    {
      "name": "libtasn1",
      "platform": "ios | osx | linux"
    },
    "libxml2",
    "libzip",
    "meshoptimizer",
    "nlohmann-json",
    "o2",
    "proj",
    "protobuf",
    {
      "name": "qca",
      "default-features": false,
      "features": [
        "ossl"
      ]
    },
    "qtbase",
    {
      "name": "qtkeychain-qt6",
      "platform": "windows"
    },
    "qtlocation",
    "qtsvg",
    "qtconnectivity",
    "qtserialport",
    {
      "name": "qtmacextras",
      "platform": "osx"
    },

    "qwt",
    "qttools",
    "qscintilla",
    "qtkeychain",
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "3d": {
      "description": "Determines whether QGIS 3D library should be built",
      "dependencies": [
        "qt3d"
      ]
    },
    "bindings": {
      "description": "Determines whether Python bindings should be built",
      "dependencies": [
        "gdal",
        "python3"
      ]
    },
    "gui": {
      "description": "Determines whether the QGIS gui should be built",
      "dependencies": [
        {
          "name": "qscintilla",
          "platform": "windows"
        },
        "qtmultimedia",
        {
          "name": "qwt",
          "platform": "windows"
        }
      ]
    },
    "pdal": {
      "description": "Build with PDAL point cloud processing support",
      "dependencies": [
        "pdal"
      ]
    },
    "quick": {
      "description": "Build the QGIS quick components for mobile interfaces",
      "dependencies": [
        "qtdeclarative",
        "qtquickcontrols2"
      ]
    },
    "server": {
      "description": "Determines whether QGIS server should be built",
      "dependencies": [
        "fastcgi"
      ]
    },
    "debug-tools": {
      "description": "Build with QGIS developer and debugging tools",
      "dependencies": []
    }
  }
}