{
  "name": "qgis",
  "version": "3.44.5",
  "port-version": 0,
  "description": "QGIS is a free, open source, cross platform (lin/win/mac) geographical information system (GIS)",
  "homepage": "https://qgis.org",
  "dependencies": [
    "expat",
    "libxml2",
    "libzip",
    "zlib",
    "libspatialindex",
    "libspatialite",
    "gdal",
    {
      "name": "exiv2",
      "features": [
        "xmp"
      ]
    },
    "gsl",
    "libpq",
    "protobuf",
    "proj",
    "geos",
    "o2",
    "jhasse-poly2tri",
    "sqlite3",
    "nlohmann-json",
    {
      "name": "qt5-base",
      "default-features": false
    },
    "qt5-svg",
    "qt5-tools",
    "qt5-location",
    "qt5-connectivity",
    "qt5-serialport",
    {
      "name": "qt5-macextras",
      "platform": "osx"
    },
    {
      "name": "qt5-winextras",
      "platform": "windows"
    },
    "qwt",
    {
      "name": "qca",
      "default-features": false,
      "features": [
        "ossl"
      ]
    },
    "qscintilla",
    "qtkeychain",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "server": {
      "description": "Determines whether QGIS server should be built",
      "dependencies": [
          "fastcgi"
      ]
    },
    "bindings": {
      "description": "Determines whether python bindings should be built",
      "dependencies": [
          "python3"
      ]
    },
    "3d": {
      "description": "Determines whether QGIS 3D library should be built",
      "dependencies": [
          "qt5-3d"
      ]
    },
    "pdal": {
      "description": "Determines whether PDAL support should be built",
      "dependencies": [
          "pdal",
          "zstd"
      ]
    },
    "quick": {
      "description": "Determines whether QGIS Quick library should be built",
      "dependencies": [
          "qt5-declarative",
          "qt5-quickcontrols2"
      ]
    },
    "opencl": {
      "description": "Determines whether OpenCL support should be built",
      "dependencies": [
          "opencl"
      ]
    },
    "debug-tools": {
      "description": "Install debug tools for qgis"
    },
    "pip-mirrors": {
      "description": "Use aliyun proxy to speed up pypi downloads in China"
    }
  }
}
