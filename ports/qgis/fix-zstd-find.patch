diff --git a/cmake/FindZSTD.cmake b/cmake/FindZSTD.cmake
index a14fdf2e1d..61fbf12edb 100644
--- a/cmake/FindZSTD.cmake
+++ b/cmake/FindZSTD.cmake
@@ -11,25 +11,34 @@
 # Redistribution and use is allowed according to the terms of the BSD license.
 # For details see the accompanying COPYING-CMAKE-SCRIPTS file.
 
-FIND_PATH(ZSTD_INCLUDE_DIR
-  zstd.h
-  PATHS
-  "$ENV{LIB_DIR}/include"
-  "$ENV{INCLUDE}"
-  /usr/local/include
-  /usr/include
-  PATH_SUFFIXES
-  zstd
-)
+# Try to use the config file first (vcpkg provides this)
+find_package(zstd CONFIG QUIET)
 
-FIND_LIBRARY(ZSTD_LIBRARY NAMES zstd PATHS "$ENV{LIB_DIR}/lib" "$ENV{LIB}" /usr/local/lib /usr/lib )
+if(TARGET zstd::libzstd_shared OR TARGET zstd::libzstd_static)
+  set(ZSTD_FOUND TRUE)
+  if(TARGET zstd::libzstd_shared)
+    set(ZSTD_LIBRARY zstd::libzstd_shared)
+  else()
+    set(ZSTD_LIBRARY zstd::libzstd_static)
+  endif()
+  get_target_property(ZSTD_INCLUDE_DIR ${ZSTD_LIBRARY} INTERFACE_INCLUDE_DIRECTORIES)
+  message(STATUS "Found ZSTD via config: ${ZSTD_LIBRARY}")
+else()
+  # Fallback to manual search
+  FIND_PATH(ZSTD_INCLUDE_DIR
+    zstd.h
+    PATHS
+    "$ENV{LIB_DIR}/include"
+    "$ENV{INCLUDE}"
+    /usr/local/include
+    /usr/include
+    PATH_SUFFIXES
+    zstd
+  )
 
-INCLUDE(FindPackageHandleStandardArgs)
-FIND_PACKAGE_HANDLE_STANDARD_ARGS(ZSTD DEFAULT_MSG
-                                  ZSTD_LIBRARY ZSTD_INCLUDE_DIR)
+  FIND_LIBRARY(ZSTD_LIBRARY NAMES zstd zstd_static PATHS "$ENV{LIB_DIR}/lib" "$ENV{LIB}" /usr/local/lib /usr/lib )
 
-MARK_AS_ADVANCED(ZSTD_LIBRARY ZSTD_INCLUDE_DIR)
-
-IF (ZSTD_FOUND)
-  MESSAGE(STATUS "Found ZSTD: ${ZSTD_LIBRARY}")
-ENDIF (ZSTD_FOUND)
+  INCLUDE(FindPackageHandleStandardArgs)
+  FIND_PACKAGE_HANDLE_STANDARD_ARGS(ZSTD DEFAULT_MSG ZSTD_LIBRARY ZSTD_INCLUDE_DIR)
+  MARK_AS_ADVANCED(ZSTD_LIBRARY ZSTD_INCLUDE_DIR)
+endif()
