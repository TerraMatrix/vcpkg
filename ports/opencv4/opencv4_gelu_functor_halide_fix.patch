+    void attachHalide(const Halide::Expr& input, Halide::Func& top)
+    {
+        Halide::Var x("x"), y("y"), c("c"), n("n");
+        // Gelu activation: 0.5 * x * (1.0 + erf(x * sqrt(0.5)))
+        // Use tanh approximation: gelu(x) ≈ 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
+        float sqrt_2_over_pi = 0.7978845608028654f;  // sqrt(2/pi)
+        float approx_coef = 0.044715f;
+        top(x, y, c, n) = 0.5f * input * (1.0f + tanh(sqrt_2_over_pi * (input + approx_coef * input * input * input)));
+    }
+#endif  // HAVE_HALIDE
